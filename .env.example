# Copy to .env and fill in. .env is gitignored — never commit real keys.

ANTHROPIC_API_KEY=sk-ant-...

# Model used for extraction only. Never used for arithmetic.
LANDED_EXTRACTION_MODEL=claude-sonnet-5

# Path to the organizer-supplied challenge pack (contents are gitignored)
LANDED_PACK_DIR=packs/official

# Deterministic seed for the mutation harness
LANDED_SEED=42
