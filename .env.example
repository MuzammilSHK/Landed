# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Database ---------------------------------------------------------------
# PostgreSQL is the deployment target (docker compose up -d brings one up).
LANDED_DATABASE_URL=postgresql+psycopg://landed:landed@localhost:5432/landed
# Zero-setup fallback — works with no server running:
# LANDED_DATABASE_URL=sqlite:///./landed.db

# --- Extraction provider ----------------------------------------------------
# anthropic | gemini | ollama. Extraction is the only stage that calls a model;
# arithmetic never does.
LANDED_PROVIDER=anthropic
LANDED_EXTRACTION_MODEL=claude-sonnet-5

# Billed separately from a Claude Pro subscription — see console.anthropic.com
ANTHROPIC_API_KEY=

# Free tier alternative — see aistudio.google.com
GEMINI_API_KEY=
# LANDED_PROVIDER=gemini
# LANDED_EXTRACTION_MODEL=gemini-2.0-flash

# Fully local, no data leaves the machine
LANDED_OLLAMA_HOST=http://localhost:11434

# --- Web --------------------------------------------------------------------
# Sign sessions with a real random value in anything but local development.
LANDED_SECRET_KEY=dev-only-change-me

# --- Reproducibility --------------------------------------------------------
LANDED_SEED=42
